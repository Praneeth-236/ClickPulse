# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093
KAFKA_TOPIC=retailmart_clickstream
KAFKA_GROUP_ID=clickpulse-ingestion

# HDFS
HDFS_NAMENODE_URI=hdfs://localhost:9000
HDFS_RAW_PATH=/clickpulse/raw
HDFS_REJECTED_PATH=/clickpulse/rejected

# Iceberg
ICEBERG_CATALOG=clickpulse_catalog
ICEBERG_DATABASE=retailmart
ICEBERG_TABLE=clickstream_events
ICEBERG_REJECTED_TABLE=rejected_events

# Spark
SPARK_MASTER=spark://localhost:7077

# Druid
DRUID_ROUTER_URL=http://localhost:8888
DRUID_DATASOURCE=retailmart_clickstream

# Airflow
AIRFLOW_HOME=./airflow

# Dashboard
DASHBOARD_PORT=8501
